-- Seleciona o banco de dados "azure_company" para que os comandos seguintes sejam executados nele
use azure_company;

-- Criação da tabela de funcionários (employee) com seus atributos e restrições básicas
CREATE TABLE employee(
	Fname varchar(15) not null,                 -- Primeiro nome do funcionário (obrigatório)
    Minit char,                                   -- Inicial do nome do meio
    Lname varchar(15) not null,                 -- Sobrenome do funcionário (obrigatório)
    Ssn char(9) not null,                         -- Número de Segurança Social (CPF/RG americano), usado como identificador
    Bdate date,                                   -- Data de nascimento
    Address varchar(30),                          -- Endereço
    Sex char,                                     -- Sexo/Gênero
    Salary decimal(10,2),                         -- Salário (com 2 casas decimais)
    Super_ssn char(9),                            -- SSN do supervisor (auto-relacionamento)
    Dno int not null,                             -- Número do departamento ao qual o funcionário pertence
    constraint chk_salary_employee check (Salary> 2000.0), -- Restrição: o salário deve ser superior a 2000.0
    constraint pk_employee primary key (Ssn)      -- Define o Ssn como Chave Primária da tabela
);

-- Altera a tabela employee para adicionar uma chave estrangeira de auto-relacionamento (um funcionário supervisiona outro)
alter table employee 
	add constraint fk_employee 
	foreign key(Super_ssn) references employee(Ssn)
    on delete set null                            -- Se o supervisor for deletado, o campo fica NULL
    on update cascade;                            -- Se o Ssn do supervisor mudar, atualiza automaticamente aqui

-- Modifica a coluna Dno para garantir que seja obrigatória (not null) e defina o valor padrão como 1 caso não informado
alter table employee modify Dno int not null default 1;


-- Criação da tabela de departamentos (departament)
create table departament(
	Dname varchar(15) not null,                 -- Nome do departamento (obrigatório)
    Dnumber int not null,                         -- Número/Código do departamento (obrigatório)
    Mgr_ssn char(9) not null,                     -- SSN do gerente do departamento
    Mgr_start_date date,                          -- Data de início do gerente no cargo
    Dept_create_date date,                        -- Data de criação do departamento
    constraint chk_date_dept check (Dept_create_date < Mgr_start_date), -- Restrição: criação deve ser anterior ao início do gerente
    constraint pk_dept primary key (Dnumber),     -- Define Dnumber como Chave Primária
    constraint unique_name_dept unique(Dname),    -- Garante que o nome do departamento seja único
    foreign key (Mgr_ssn) references employee(Ssn) -- Chave estrangeira ligando o gerente ao funcionário
);

-- Remove a chave estrangeira padrão gerada automaticamente para o gerente
alter table departament drop  departament_ibfk_1;

-- Recria a chave estrangeira do gerente especificando o comportamento de atualização em cascata
alter table departament 
		add constraint fk_dept foreign key(Mgr_ssn) references employee(Ssn)
        on update cascade;
        

-- Criação da tabela de localizações dos departamentos (permite múltiplos locais por departamento)
create table dept_locations(
	Dnumber int not null,                       -- Número do departamento
	Dlocation varchar(15) not null,             -- Localização/cidade do departamento
    constraint pk_dept_locations primary key (Dnumber, Dlocation), -- Chave primária composta pelas duas colunas
    constraint fk_dept_locations foreign key (Dnumber) references departament (Dnumber) -- Chave estrangeira ligando ao departamento
);

-- Remove a chave estrangeira anterior de localização
alter table dept_locations drop fk_dept_locations;

-- Recria a chave estrangeira de localizações aplicando exclusão e atualização em cascata
alter table dept_locations 
	add constraint fk_dept_locations foreign key (Dnumber) references departament(Dnumber)
	on delete cascade
    on update cascade;

-- Criação da tabela de projetos
create table project(
	Pname varchar(15) not null,                 -- Nome do projeto
	Pnumber int not null,                       -- Número/ID do projeto
    Plocation varchar(15),                        -- Localização do projeto
    Dnum int not null,                          -- Número do departamento que controla o projeto
    primary key (Pnumber),                        -- Define Pnumber como Chave Primária
    constraint unique_project unique (Pname),     -- Garante que o nome do projeto seja único
    constraint fk_project foreign key (Dnum) references departament(Dnumber) -- Chave estrangeira ligando ao departamento controlador
);


-- Criação da tabela associativa que registra quais funcionários trabalham em quais projetos (relação N para N)
create table works_on(
	Essn char(9) not null,                      -- SSN do funcionário
    Pno int not null,                           -- Número do projeto
    Hours decimal(3,1) not null,                -- Horas trabalhadas por semana no projeto
    primary key (Essn, Pno),                      -- Chave primária composta para evitar duplicidade de funcionário no mesmo projeto
    constraint fk_employee_works_on foreign key (Essn) references employee(Ssn), -- Chave estrangeira ligando ao funcionário
    constraint fk_project_works_on foreign key (Pno) references project(Pnumber)   -- Chave estrangeira ligando ao projeto
);

-- Remove a tabela de dependentes caso já exista (evita erro de tabela duplicada)
drop table dependent;

-- Criação da tabela de dependentes dos funcionários
create table dependent(
	Essn char(9) not null,                      -- SSN do funcionário responsável (chave estrangeira)
    Dependent_name varchar(15) not null,          -- Nome do dependente
    Sex char,                                     -- Sexo do dependente
    Bdate date,                                   -- Data de nascimento do dependente
    Relationship varchar(8),                      -- Parentesco (ex: Filho, Cônjuge)
    primary key (Essn, Dependent_name),           -- Chave primária composta (um funcionário não pode ter dois dependentes com o mesmo nome)
    constraint fk_dependent foreign key (Essn) references employee(Ssn) -- Chave estrangeira ligando ao funcionário
);


